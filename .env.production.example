APP_NAME=Siscoop3F
APP_ENV=production
APP_KEY=base64:GENERATE_ON_SERVER
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://siscoop3f.com.br

# Tenancy Config
TENANCY_CENTRAL_DOMAINS=siscoop3f.com.br
SESSION_DOMAIN=.siscoop3f.com.br

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seu_prefixo_central
DB_USERNAME=seu_prefixo_user
DB_PASSWORD=sua_senha

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.siscoop3f.com.br

CACHE_STORE=file
CACHE_PREFIX=siscoop3f_cache

FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

VITE_APP_NAME="${APP_NAME}"
